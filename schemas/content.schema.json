{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cet-lab.local/schemas/content.schema.json",
  "title": "CET-Lab Normalized Exam Bundle",
  "description": "Markdown 作者格式經 scripts/validate-content.ts 正規化後的 JSON 結構。Phase 1 會以 Zod 實作等價規則，並加入跨檔案引用檢查（passage_id、audio_asset_id）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "exam", "passages", "questions", "assets"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1"] },
    "exam": { "$ref": "#/$defs/exam" },
    "passages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/passage" }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/question" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "section": {
      "enum": ["reading", "listening", "writing", "translation", "speaking"]
    },
    "hotTopic": {
      "enum": [
        "ai_ethics",
        "climate_change",
        "remote_work",
        "mental_health",
        "new_energy",
        "tech_ethics",
        "aging_population",
        "urbanization",
        "digital_economy",
        "biodiversity",
        "education_technology",
        "public_health",
        "unclassified"
      ]
    },
    "knowledgeTag": {
      "enum": [
        "main_idea",
        "detail",
        "inference",
        "attitude",
        "vocabulary_in_context",
        "text_structure",
        "signposting",
        "paraphrase",
        "listening_detail",
        "listening_inference",
        "listening_attitude",
        "logic_gap",
        "cohesion"
      ]
    },
    "errorCause": {
      "enum": ["lexical", "grammar", "locating", "inference", "time_pressure", "carelessness"]
    },
    "questionType": {
      "enum": [
        "detail",
        "inference",
        "attitude",
        "main_idea",
        "vocabulary_in_context",
        "text_structure",
        "listening_detail",
        "listening_inference",
        "listening_attitude",
        "signposting",
        "paraphrase",
        "banked_cloze",
        "translation",
        "writing_task"
      ]
    },
    "accent": {
      "enum": ["us", "british", "australian", "canadian", "other"]
    },
    "exam": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "year",
        "month",
        "set",
        "source",
        "license",
        "content_version",
        "sections"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^exam_[a-z0-9_-]+$", "maxLength": 80 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
        "month": { "type": "integer", "minimum": 1, "maximum": 12 },
        "set": { "type": "string", "pattern": "^[a-z0-9_-]+$", "maxLength": 40 },
        "source": {
          "enum": ["user-entered", "original", "licensed", "public-domain"]
        },
        "license": { "type": "string", "minLength": 1, "maxLength": 100 },
        "content_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/section" }
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "exam_id",
        "section",
        "subtype",
        "order",
        "title",
        "body_md",
        "word_count",
        "hot_topic_tags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^psg_[a-z0-9_-]+$", "maxLength": 80 },
        "exam_id": { "type": "string", "pattern": "^exam_[a-z0-9_-]+$" },
        "section": { "$ref": "#/$defs/section" },
        "subtype": {
          "enum": ["careful_reading", "banked_cloze"],
          "default": "careful_reading"
        },
        "order": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "body_md": { "type": "string", "minLength": 1 },
        "word_count": { "type": "integer", "minimum": 1 },
        "hot_topic_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hotTopic" }
        },
        "word_bank": {
          "type": "array",
          "items": { "$ref": "#/$defs/option" }
        },
        "audio_asset_id": { "type": ["string", "null"], "pattern": "^aud_[a-z0-9_-]+$" },
        "accent": {
          "oneOf": [{ "$ref": "#/$defs/accent" }, { "type": "null" }]
        },
        "wpm": {
          "oneOf": [
            { "type": "number", "minimum": 80, "maximum": 220 },
            { "type": "null" }
          ]
        },
        "transcript": { "type": ["string", "null"], "minLength": 1 },
        "transcript_zh": { "type": ["string", "null"], "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "section": { "const": "listening" } },
            "required": ["section"]
          },
          "then": {
            "required": ["audio_asset_id", "transcript"],
            "properties": {
              "audio_asset_id": { "type": "string" },
              "transcript": { "type": "string" }
            }
          }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "text"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-O]$" },
        "text": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paragraph": { "type": "integer", "minimum": 1 },
        "sentence": { "type": "integer", "minimum": 1 },
        "segment": { "type": "integer", "minimum": 0 },
        "quote": { "type": "string", "minLength": 1, "maxLength": 2000 }
      },
      "anyOf": [
        { "required": ["paragraph", "sentence"] },
        { "required": ["segment"] }
      ]
    },
    "audioSpan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "exam_id",
        "passage_id",
        "section",
        "type",
        "stem",
        "answer",
        "explanation",
        "evidence",
        "knowledge_tags",
        "error_cause_tags",
        "difficulty"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^q_[a-z0-9_-]+$", "maxLength": 90 },
        "exam_id": { "type": "string", "pattern": "^exam_[a-z0-9_-]+$" },
        "passage_id": { "type": "string", "pattern": "^psg_[a-z0-9_-]+$" },
        "section": { "$ref": "#/$defs/section" },
        "type": { "$ref": "#/$defs/questionType" },
        "stem": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 15,
          "items": { "$ref": "#/$defs/option" }
        },
        "answer": { "type": "string", "minLength": 1, "maxLength": 200 },
        "explanation": { "type": "string", "minLength": 1, "maxLength": 5000 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence" }
        },
        "knowledge_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/knowledgeTag" }
        },
        "error_cause_tags": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/errorCause" }
        },
        "hot_topic_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/hotTopic" }
        },
        "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
        "blank_index": { "type": "integer", "minimum": 1 },
        "audio_span": {
          "oneOf": [{ "$ref": "#/$defs/audioSpan" }, { "type": "null" }]
        },
        "generated": { "type": "boolean", "default": false }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "enum": ["translation", "writing_task", "banked_cloze"] }
            },
            "required": ["type"]
          },
          "else": { "required": ["options"] }
        },
        {
          "if": {
            "properties": { "type": { "const": "banked_cloze" } },
            "required": ["type"]
          },
          "then": { "required": ["blank_index"] }
        }
      ]
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "text"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "minimum": 0 },
        "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
        "textZh": { "type": "string", "minLength": 1, "maxLength": 2000 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "backend", "license"],
      "properties": {
        "id": { "type": "string", "pattern": "^(aud|img)_[a-z0-9_-]+$", "maxLength": 90 },
        "kind": { "enum": ["audio", "image"] },
        "backend": { "enum": ["local", "url", "tts"] },
        "src": { "type": "string", "maxLength": 2000 },
        "accent": {
          "oneOf": [{ "$ref": "#/$defs/accent" }, { "type": "null" }]
        },
        "wpm": {
          "oneOf": [
            { "type": "number", "minimum": 80, "maximum": 220 },
            { "type": "null" }
          ]
        },
        "synthetic": { "type": "boolean", "default": false },
        "license": { "type": "string", "minLength": 1, "maxLength": 200 },
        "duration_sec": { "type": "number", "minimum": 0 },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/segment" }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "backend": { "const": "tts" } },
            "required": ["backend"]
          },
          "then": {
            "required": ["synthetic"],
            "properties": { "synthetic": { "const": true } }
          }
        },
        {
          "if": {
            "properties": { "backend": { "enum": ["local", "url"] } },
            "required": ["backend"]
          },
          "then": {
            "required": ["src"],
            "properties": {
              "src": { "type": "string", "minLength": 1 },
              "segments": {
                "type": "array",
                "items": {
                  "allOf": [
                    { "$ref": "#/$defs/segment" },
                    { "required": ["start", "end"] }
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
